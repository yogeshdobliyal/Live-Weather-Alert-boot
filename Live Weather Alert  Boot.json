    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\n\nconst user =$input.first().json.body.userId ||'anon';\nconst now = Date.now();\n\nif(!store[user]){\n  store[user] =[];\n  \n}\n\nstore[user] = store[user].filter(t => now - t < 60000);\nif(store[user].length >= 5){\n  throw new Error('Rate limit Exceeded');\n}\n\nstore[user].push(now);\nreturn $input.all();\n\n"
      },
