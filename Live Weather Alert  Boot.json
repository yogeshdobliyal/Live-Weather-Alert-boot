    {
      "parameters": {
        "jsCode": "const headers = $input.first().json.headers;\nconst ts = parseInt(headers['x-timestamp']);\nconst now = Math.floor(Date.now() / 1000);\nif(!ts || Math.abs (now - ts) > 300){\n  throw new Error('Request Expired');\n}\nreturn $input.all();"
      },
